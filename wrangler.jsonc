{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "5km-studio-blog",
  "keep_names": false,
  "preview_urls": false,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-09-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "5km-studio-blog" },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "5km-studio-blog-cache",
    },
  ],
  "d1_databases": [{"binding":"BLOG_DB","database_name":"5km-studio-blog-data","database_id":"7a55f78d-b5f5-4fd9-8232-5b8bc5632f5f","migrations_dir":"db/d1-migrations"}],
  "ratelimits": [
    {"name":"RATE_GENERAL","namespace_id":"1001","simple":{"limit":30,"period":10}},
    {"name":"RATE_COMMENTS","namespace_id":"1002","simple":{"limit":10,"period":10}},
    {"name":"RATE_NEWSLETTER","namespace_id":"1003","simple":{"limit":1,"period":10}},
    {"name":"RATE_ACTIVITY","namespace_id":"1004","simple":{"limit":5,"period":10}}
  ],
  "images": { "binding": "IMAGES" },
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
    ],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
  "vars": { "APP_ENV": "production" },
  "routes": [
    { "pattern": "5km.studio", "custom_domain": true, "zone_id": "40c077eff02319f37a8389866858d115" },
  ],
  "observability": { "enabled": true },
  "workers_dev": true,
}
